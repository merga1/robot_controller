[Unit]
Description=Robot Control API (FastAPI backend)
After=network-online.target robot-beacon.service
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@HOME@/raspberry_pi
ExecStart=/usr/bin/bash @HOME@/raspberry_pi/run_server_ros.sh
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
