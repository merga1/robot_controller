# Link to your EXISTING articubot_one workspace on the Pi.
# Copy to real1_link.env:  cp real1_link.env.example real1_link.env
#
# Both workspaces must be built and sourced (order matters: l2jd_ws first):
#   source /home/delv/l2jd_ws/install/setup.bash
#   source /home/delv/articubot_one1/install/setup.bash
#   ros2 launch articubot_one master.launch.py
#
# Set REAL1_WS to the articubot_one1 workspace (contains install/setup.bash):

# REAL1_WS=/home/delv/articubot_one1
# REAL1_SCRIPTS=/home/delv/articubot_one1/src/articubot_one/scripts

# Extra workspace to source before REAL1_WS (l2jd_ws must be sourced first):
REAL1_EXTRA_SETUP=/home/delv/l2jd_ws/install/setup.bash

REAL1_WS=/home/delv/articubot_one1

# Launch command: articubot_one master.launch.py replaces robotBridge.launch.py
REAL1_START_CMD=ros2 launch articubot_one master.launch.py

# Motors re-init: restart the launch (clears errors + enables motors on startup)
REAL1_ENABLE_MOTORS_MODE=restart_bridge

# articubot_one expects standard ROS m/s units on /cmd_vel
REAL1_CMD_VEL_UNITS=ms
REAL1_CMD_VEL_LINEAR_SCALE=1.0
REAL1_CMD_VEL_ANGULAR_SCALE=1.0

# tablet = Flutter pad only (recommended). both/gamepad also starts gamepad.py
REAL1_JOYSTICK_MODE=tablet
REAL1_PI_GAMEPAD=0
REAL1_AUTO_ENABLE_ON_JOYSTICK=0

# Navigation map for the Flutter tablet app.
# Default: REAL1_WS/src/articubot_one/maps/my_map.yaml
# Override with this env var to use a different map file:
# ROBOT_MAP_YAML=/home/delv/articubot_one1/src/articubot_one/maps/my_map.yaml
