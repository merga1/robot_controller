# Link to your EXISTING Real1 workspace on the Pi.
# Copy to real1_link.env:  cp real1_link.env.example real1_link.env
#
# delv and abpi are used interchangeably — the backend auto-finds Real1 under
# /home/abpi/Real1 or /home/delv/Real1 (whichever contains robotBridge.py).
# Set these only to force a specific home:

# REAL1_WS=/home/abpi/Real1
# REAL1_SCRIPTS=/home/abpi/Real1/src/Real1/scripts

# Or if Real1 lives under delv:
# REAL1_WS=/home/delv/Real1
# REAL1_SCRIPTS=/home/delv/Real1/src/Real1/scripts

REAL1_START_CMD=ros2 run Real1 robotBridge.py

# Motors re-init: restart robotBridge (Clear error + Enable motor inside bridge)
REAL1_ENABLE_MOTORS_MODE=restart_bridge

# CRITICAL: L2JD robotBridge uses RPM in linear.x — NOT m/s.
REAL1_CMD_VEL_UNITS=rpm
REAL1_MAX_LINEAR_RPM=10
REAL1_MAX_ANGULAR_RPM=100

# tablet = Flutter pad only (recommended). both/gamepad also starts gamepad.py
REAL1_JOYSTICK_MODE=tablet
REAL1_PI_GAMEPAD=0
REAL1_AUTO_ENABLE_ON_JOYSTICK=0
